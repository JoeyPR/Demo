<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_backClaw" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="1,11"/>
    <Sprite name="s_frontClaw" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="0,11"/>
    <Sprite name="s_lightning" fileName="game/particles_large18.rttex" textureSize="64" frame="0,15"/>
    <Sprite name="s_aura" fileName="game/particles_large18.rttex" textureSize="64" frame="10,15"/>
    <Sprite name="s_speed_lines" fileName="game/particles12.rttex" textureSize="32" frame="8,23"/>
    <Sprite name="s_slash" fileName="game/particles12.rttex" textureSize="32,32" frame="2,23" />
    <Sprite name="s_chunks" fileName="game/particles12.rttex" textureSize="32,32" frame="5,23" />

    <Animations>

      <SpriteAnimation name="a_lightning" autoPlay="true" sprite="s_lightning" animTime="1000" isLoop="true">
        <Frame>0,15</Frame>
        <Frame>1,15</Frame>
        <Frame>2,15</Frame>
        <Frame>3,15</Frame>
        <Frame>4,15</Frame>
        <Frame>5,15</Frame>
        <Frame>6,15</Frame>
        <Frame>7,15</Frame>
        <Frame>8,15</Frame>
        <Frame>9,15</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_speed_lines" autoPlay="false" sprite="s_speed_lines">
        <Frame>8,23</Frame>
        <Frame>9,23</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_slash" autoPlay="false" sprite="s_slash">
        <Frame>2,23</Frame>
        <Frame>3,23</Frame>
        <Frame>4,23</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_chunks" autoPlay="false" sprite="s_chunks">
        <Frame>5,23</Frame>
        <Frame>6,23</Frame>
        <Frame>7,23</Frame>
      </SpriteAnimation>
    </Animations>

    <StateMachines>
      <StateMachine name="Action">
        <States>
          <State name="None" />
          <State name="Punch" />
        </States>
        <Transitions>
          <Transition to="None" from="Punch">
            <Condition>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="Punch" from="None">
            <Condition>
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>

    <ParticleSystems>
      <ParticleSystem name="ps_Aura" updateStage="AddClothingParticles" renderStage="RenderHandItem">
        <Emitter>
          <Set name="offset">0, -12</Set>
          <Set name="emissionInterval">0.15</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_aura</Set>
          <Set name="relativeToEmitter">true</Set>
          <Random name="offset" min="-3, 3" max="0, 0" />
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.4, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="isBackgroundParticle">true</Set>
          <Set name="inSpecificOrder">true</Set>
          <Curve name="initialScale">
            <KeyFrame>0, 0.75, 0.75</KeyFrame>
            <KeyFrame>1, 1, 1.25</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.3</Set>
          <Set name="initialVelocity">0, -100</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_SpeedLines" updateStage="AddClothingParticles" renderStage="RenderHandItem">
        <Emitter>
          <Set name="offset">0, -10</Set>
          <Set name="offsetFacing">false</Set>
          <Random name="emissionInterval" min="0.15" max="0.25" />
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle  randomSpriteFrame="true">
          <Set name="sprite">s_speed_lines</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="inSpecificOrder">true</Set>
          <Random name="offset" min="-8, 0" max="8, 0" />
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 1,1</KeyFrame>
            <KeyFrame>1, 1,2</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.3</Set>
          <Random name="initialVelocity" min="0, -50" max="0, -80" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_slash" updateStage="OnPunchUpdate">
        <Emitter attachment="targetPos">
          <Set name="lifeTime">0.1</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="lifeTime">0.3</Set>
          <Set name="sprite">s_slash</Set>
          <Random name="initialAngle" min="0" max="360"/>
          <Random name="offset" min="-8,-8" max="8,8"/>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_tile_fx">
        <Emitter>
          <Set name="lifeTime">2</Set>
          <Set name="particlesPerEmission">8</Set>
          <Set name="offset">0,0</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_chunks</Set>
          <RandomRadial name="initialVelocity" angleRange="30,330" radiusRange="80,200"/>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">1</Set>
          <Set name="useGravity">true</Set>
          <Set name="gravityVector">0, 100</Set>
          <Set name="initialScale">1,1</Set>
          <Random name="finalScale" min="0.1" max="0.4"/>
          <Set name="interpolateScale">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialRotationRate">
            <KeyFrame>0, 15</KeyFrame>
            <KeyFrame>1, 5</KeyFrame>
          </Curve>
          <Random name="initialAngle" min="0" max="360"/>
          <Random name="offset" min="0,0" max="16,16"/>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
    
    <RenderOptions>
      <Default>
        <Set name="PunchSoundOverride">HAND</Set>
        <Set name="PlayDefaultPunchAudio">false</Set>
        <Set name="RenderBackArmInfected">true</Set>
        <Set name="RenderFrontArmInfected">true</Set>
        <Set name="RenderBackArmBuild">true</Set>
        <Set name="IncludeAllActions">true</Set>
        <Set name="DefaultRenderMannequinHandItem">false</Set>
      </Default>
    </RenderOptions>
  </Data>

  <RenderRules>
    <OnPunchUpdate>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm1Angle</Set>
        <Set name="animTime">300</Set>
        <Set name="Curve">
          <KeyFrame>0, 0</KeyFrame>
          <KeyFrame>1, 360</KeyFrame>
        </Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm2Angle</Set>
        <Set name="animTime">300</Set>
        <Set name="Curve">
          <KeyFrame>0, 180</KeyFrame>
          <KeyFrame>1, 540</KeyFrame>
        </Set>
      </AvatarTransform>
    </OnPunchUpdate>
    <Update type="or">
      <StopIf>
        <IsZombified>true</IsZombified>
      </StopIf>
      <AvatarTransform class="Emotion">
        <Set name="emotion">ANGRY</Set>
      </AvatarTransform>
      <StopIf>
        <IsAction>PUNCH</IsAction>
        <IsVariableBool name="onGround">false</IsVariableBool>
      </StopIf>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm2Angle</Set>
        <Set name="armAngle">45</Set>
      </AvatarTransform>
      <StopIf type="or">
        <IsAction>BUILD</IsAction>
      </StopIf>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm1Angle</Set>
        <Set name="armAngle">-45</Set>
      </AvatarTransform>
    </Update>
    <RenderHandItem>
      <SpriteRender name="s_frontClaw" offset="0,1" rotateOffset="true" rotationPoint="0,1" blend="PREMULTIPLIED_ALPHA" alignment="UPPER_CENTER" drawShadow="true" />
    </RenderHandItem>
    <RenderBackHandItem>
      <StopIf>
        <IsAction>BUILD</IsAction>
      </StopIf>
      <StopIf type="and">
        <IsZombified>true</IsZombified>
        <IsAction>PUNCH</IsAction>
      </StopIf>
      <SpriteRender name="s_backClaw" offset="-4,6" rotateOffset="true" rotationPoint="1,1" blend="PREMULTIPLIED_ALPHA" alignment="CENTER" drawShadow="true" />
    </RenderBackHandItem>
    <RenderInFront>
      <StopIf>
        <IsZombified>true</IsZombified>
        <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
      </StopIf>
      <SpriteRender name="s_lightning" alignment="DOWN_CENTER" drawShadow="false" blend="PREMULTIPLIED_ALPHA"/>
    </RenderInFront>
    <OnDamagedTile>
      <ParticleSystemUpdate name="ps_tile_fx"/>
    </OnDamagedTile>
    <OnDestroyedTile>
      <ParticleSystemUpdate name="ps_tile_fx"/>
    </OnDestroyedTile>
  </RenderRules>
</ItemRenderer>