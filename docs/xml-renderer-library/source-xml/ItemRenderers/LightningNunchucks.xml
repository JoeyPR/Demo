<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_Equip" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="16,11"/>
		<Sprite name="s_Slash" fileName="game/particles12.rttex" textureSize="32,32" frame="21,22" />
		<Sprite name="s_Hit" fileName="game/particles12.rttex" textureSize="32" frame="26,22" />
		<Sprite name="s_Break" fileName="game/particles_large17.rttex" textureSize="64" frame="15,8" />
		<Animations>
			<SpriteAnimation name="a_Equip" sprite="s_Equip" animTime="1200" isLoop="true" playOnState="Swing.No">
				<Frame>10,12</Frame>
				<Frame>11,12</Frame>
				<Frame>12,12</Frame>
				<Frame>13,12</Frame>
				<Frame>14,12</Frame>
				<Frame>15,12</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_Dance" sprite="s_Equip" animTime="400" isLoop="true" playOnState="Swing.Yes">
				<Frame>10,11</Frame>
				<Frame>11,11</Frame>
				<Frame>12,11</Frame>
				<Frame>13,11</Frame>
				<Frame>14,11</Frame>
				<Frame>15,11</Frame>
				<Frame>16,11</Frame>
				<Frame>17,11</Frame>
				<Frame>18,11</Frame>
				<Frame>19,11</Frame>
				<Frame>20,11</Frame>
				<Frame>21,11</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_Hit" sprite="s_Hit">
				<Frame>26,22</Frame>
				<Frame>27,22</Frame>
			</SpriteAnimation>
		</Animations>
		<StateMachines>
			<StateMachine name="Swing">
				<States>
					<State name="No" />
					<State name="Yes" />
				</States>
				<Transitions>
					<Transition from="Yes" to="No">
						<Condition type="and">
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
							<IsAction operatorType="NotEqual">DANCE_FLOSS</IsAction>
						</Condition>
					</Transition>
					<Transition from="No" to="Yes">
						<Condition type="and">
							<SubCondition type="or">
								<IsAction>PUNCH</IsAction>
								<IsAction>DANCE_FLOSS</IsAction>
							</SubCondition>
							<IsZombified>false</IsZombified>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Punch">
				<States>
					<State name="No" />
					<State name="Yes" />
				</States>
				<Transitions>
					<Transition to="No" from="Yes">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Yes" from="No">
						<Condition type="and">
							<IsAction>PUNCH</IsAction>
							<IsZombified>false</IsZombified>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Hand">
				<States>
					<State name="Front" ExitTime="1.5" />
					<State name="Back" ExitTime="1.5"/>
				</States>
				<Transitions>
					<Transition to="Front" from="Back" />
					<Transition to="Back" from="Front" />
				</Transitions>
			</StateMachine>
		</StateMachines>
		<ParticleSystems>
			<ParticleSystem name="ps_slash" updateStage="OnPunchUpdate">
				<Emitter attachment="targetPos">
					<Set name="lifeTime">0.1</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="lifeTime">0.2</Set>
					<Set name="sprite">s_Slash</Set>
					<Random name="initialAngle" min="0" max="360"/>
					<Random name="offset" min="-8,-8" max="8,8"/>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.5, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="initialScale">0.75,0.75</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_hit" updateStage="OnDamagedTile">
				<Emitter>
					<Set name="offset">0,0</Set>
					<Set name="lifeTime">0</Set>
					<Set name="particlesPerEmission">6</Set>
					<Set name="delayTimer">0.0</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_Hit</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.6</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.5, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="50,80"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_break" updateStage="OnDestroyedTile">
				<Emitter>
					<Set name="offset">0,0</Set>
					<Set name="lifeTime">0</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="delayTimer">0.0</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_Break</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.75</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.5, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.75,0.75</KeyFrame>
						<KeyFrame>1, 1.5,1.5</KeyFrame>
					</Curve>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<TileStampData>
			<Set name="FileName">game/particles12.rttex</Set>
			<Set name="EndFrame">25,22</Set>
			<Set name="FrameCount">4</Set>
		</TileStampData>
		<RenderOptions>
			<Default>
				<Set name="PunchSoundOverride">HAND</Set>
				<Set name="IncludeAllActions">true</Set>
				<Set name="DefaultRenderMannequinHandItem">false</Set>
				<Set name="RenderFrontArmInfected">true</Set>
				<Set name="RenderFrontArmInTheFront">true</Set>
				<Set name="RenderBackArmAfterItem">true</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
		<RenderHandItem>
			<Group onState="Swing.No">
				<SpriteRender name="s_Equip" alignment="UPPER_CENTER" blend="PREMULTIPLIED_ALPHA"/>
			</Group>
			<Group onState="Swing.Yes">
				<SpriteRender name="s_Equip" offset="6,-3" rotateOffset="true" alignment="UPPER_CENTER" blend="PREMULTIPLIED_ALPHA" onState="Hand.Front"/>
			</Group>
		</RenderHandItem>
		<RenderBackHandItem>
			<Group onState="Swing.Yes">
				<SpriteRender name="s_Equip" offset="3,-8" rotateOffset="true" alignment="UPPER_CENTER" blend="PREMULTIPLIED_ALPHA" onState="Hand.Back"/>
			</Group>
		</RenderBackHandItem>
		<Update>
			<Group onState="Punch.Yes">
				<AvatarTransform class="ArmAngle" onState="Hand.Front">
					<Set name="armName">arm2Angle</Set>
					<Set name="armAngle">-40</Set>
					<Set name="pulseArmScale">20</Set>
					<Set name="pulseArmRate">300</Set>
				</AvatarTransform>
				<AvatarTransform class="ArmAngle" onState="Hand.Front">
					<Set name="armName">arm1Angle</Set>
					<Set name="armAngle">0</Set>
				</AvatarTransform>
				<AvatarTransform class="ArmAngle" onState="Hand.Back">
					<Set name="armName">arm1Angle</Set>
					<Set name="armAngle">-40</Set>
					<Set name="pulseArmScale">20</Set>
					<Set name="pulseArmRate">300</Set>
				</AvatarTransform>
				<AvatarTransform class="ArmAngle" onState="Hand.Back">
					<Set name="armName">arm2Angle</Set>
					<Set name="armAngle">0</Set>
				</AvatarTransform>
			</Group>
		</Update>
		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
		</OnPunchUpdate>
	</RenderRules>
</ItemRenderer>