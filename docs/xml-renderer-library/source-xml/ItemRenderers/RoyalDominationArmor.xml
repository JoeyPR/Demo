<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_shirt" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="23,11"/>
		<Sprite name="s_orbit" fileName="game/particles12.rttex" textureSize="32" frame="10,23"/>
		<Sprite name="s_punch" fileName="game/particles12.rttex" textureSize="32" frame="12,23" />
		<Sprite name="s_aura" fileName="game/particles_large18.rttex" textureSize="64" frame="12,14" />
		<Sprite name="s_Hit" fileName="game/particles_large18.rttex" textureSize="64" frame="15,12" />
		<Sprite name="s_Sparkle" fileName="game/particles12.rttex" textureSize="32" frame="14,23" />
		<Animations>
			<SpriteAnimation name="a_shirt" sprite="s_shirt" autoPlay="true" animTime="1200" isLoop="true">
				<Frame>23,11</Frame>
				<Frame>24,11</Frame>
				<Frame>25,11</Frame>
				<Frame>26,11</Frame>
				<Frame>27,11</Frame>
				<Frame>28,11</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_orbit" sprite="s_orbit">
				<Frame>10,23</Frame>
				<Frame>11,23</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_aura" sprite="s_aura">
				<Frame>12,14</Frame>
				<Frame>13,14</Frame>
				<Frame>14,14</Frame>
				<Frame>15,14</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_Sparkle" sprite="s_Sparkle">
				<Frame>14,23</Frame>
				<Frame>15,23</Frame>
				<Frame>16,23</Frame>
			</SpriteAnimation>
		</Animations>
		<StateMachines>
			<StateMachine name="Action">
				<States>
					<State name="None" />
					<State name="Punch" />
				</States>
				<Transitions>
					<Transition to="None" from="Punch">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="None">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<ParticleSystems>
			<ParticleSystem name="ps_orb1">
				<Emitter>
					<Set name="offset">5, -35</Set>
					<Set name="emissionInterval">0.02</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_orbit</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="orbitStart" source="posOrb"/>
					<Set name="orbitPeriod">2.4</Set>
					<Set name="orbitScaleVariation">0.2</Set>
					<Set name="applyOrbit">true</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="orbit">-30,10</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.5, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.8</Set>
					<Random name="initialScale" min="0.7" max="0.9"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_orb2">
				<Emitter>
					<Set name="offset">5, -20</Set>
					<Set name="emissionInterval">0.02</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_orbit</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="orbitStart" source="posOrb"/>
					<Set name="orbitPeriod">2.2</Set>
					<Set name="orbitScaleVariation">0.1</Set>
					<Set name="applyOrbit">true</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="orbit">30,10</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.5, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.6</Set>
					<Random name="initialScale" min="0.7" max="0.9"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_orb3">
				<Emitter>
					<Set name="offset">5, -15</Set>
					<Set name="emissionInterval">0.02</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_orbit</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="orbitStart" source="posOrb"/>
					<Set name="orbitPeriod">2</Set>
					<Set name="orbitSkew">0.5</Set>
					<Set name="orbitScaleVariation">0.1</Set>
					<Set name="applyOrbit">true</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="orbit">20,-18</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.5, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.5</Set>
					<Random name="initialScale" min="0.7" max="0.9"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_Punch" updateStage="OnPunchStart">
				<Emitter>
					<Set name="offset">14,-20</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="useCharacterPos">false</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_punch</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="lifeTime">0.4</Set>
					<Set name="rotateWithVelocity">true</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1"/>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.5, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_Aura" updateStage="OnPunchStart">
				<Emitter>
					<Set name="offset">0,8</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="useCharacterPos">false</Set>
				</Emitter>
				<Particle randomSpriteFrame="true" usePlayerFacing="true">
					<Set name="sprite">s_aura</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="lifeTime">0.5</Set>
					<Set name="renderAlignment">DOWN_CENTER</Set>
					<Set name="isBackgroundParticle">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.3,0.3</KeyFrame>
						<KeyFrame>1, 2,2</KeyFrame>
					</Curve>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_Hit" updateStage="OnDamagedTile">
				<Emitter>
					<Set name="lifeTime">0</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_Hit</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Random name="initialAngle" min="-360" max="360"/>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.4,0.4</KeyFrame>
						<KeyFrame>1, 1.3,1.3</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.5</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_HitSparkle" updateStage="OnDamagedTile">
				<Emitter>
					<Set name="offset">0,0</Set>
					<Set name="lifeTime">0</Set>
					<Set name="particlesPerEmission">6</Set>
					<Set name="delayTimer">0.0</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_Sparkle</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="lifeTime">0.4</Set>
					<Set name="initalRGB">1,1,1</Set>
					<Set name="initialScale">1,1</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="interpolateAlpha">true</Set>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="60,120"/>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<VariableMap>
			<Set name="posOrb">0</Set>
			<Set name="incOrb">0</Set>
			<Set name="DeltaTime">0.0</Set>
		</VariableMap>
		<RenderOptions>
			<Default>
				<Set name="PlayDefaultPunchAudio">true</Set>
				<Set name="ShouldHover">true></Set>
				<Set name="DisableWalkAnimation">true</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
				<Set name="IgnoreDefaultDestroyedTileEffect">true</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
		<RenderShirt>
			<SpriteRender name="s_shirt" alignment="DOWN_CENTER" blend="PREMULTIPLIED_ALPHA" />
		</RenderShirt>
		<RenderInFront>
			<ParticleSystemRender name="ps_orb1" />
			<ParticleSystemRender name="ps_orb2" />
			<ParticleSystemRender name="ps_orb3" />
		</RenderInFront>
		<AddClothingParticles>
			<ParticleSystemUpdate name="ps_orb1" />
			<ParticleSystemUpdate name="ps_orb2" />
			<ParticleSystemUpdate name="ps_orb3" />
		</AddClothingParticles>
		<Update>
			<StopIf>
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
				<IsRenderMod>RENDER_MOD_SPIRIT_GUIDE</IsRenderMod>
				<IsRenderMod>RENDER_MOD_RAINBOW_GUY</IsRenderMod>
			</StopIf>
			<ArithmethicOperation LeftHandVariableName="incOrb" RightHandVariableName="0.4" OperationType="Set"/>
			<ArithmethicOperation LeftHandVariableName="incOrb" RightHandVariableName="DeltaTime" OperationType="Multiply"/>
			<ArithmethicOperation LeftHandVariableName="posOrb" RightHandVariableName="incOrb" OperationType="Add"/>
		</Update>
		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">JUMP_UP</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">-40</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">40</Set>
			</AvatarTransform>
		</OnPunchUpdate>
		<OnDestroyedTile>
			<ParticleSystemUpdate name="ps_Hit" />
			<ParticleSystemUpdate name="ps_HitSparkle" />
		</OnDestroyedTile>
	</RenderRules>
</ItemRenderer>