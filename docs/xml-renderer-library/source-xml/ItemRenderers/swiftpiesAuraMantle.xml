<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_CapeBack" fileName="game/particles_large18.rttex" textureSize="64" frame="0,14" />
    <Sprite name="s_CapeFront" fileName="game/particles_large18.rttex" textureSize="64" frame="0,13" />
    <Sprite name="s_Hood" fileName="game/particles12.rttex" textureSize="32" frame="12,21" />
    <Sprite name="s_HoodBack" fileName="game/particles12.rttex" textureSize="32" frame="13,21" />
    <Sprite name="s_Angelic" fileName="game/particles_large18.rttex" textureSize="64" frame="6,13" />
    <Sprite name="s_Sparks" fileName="game/particles12.rttex" textureSize="32" frame="10,21" />

    <StateMachines>
      <StateMachine name="PlayerState">
        <States start="Grounded">
          <State name="Grounded"/>
          <State name="Fall"/>
          <State name="Jump"/>
        </States>
        <Transitions>
          <Transition from="Jump|Fall" to="Grounded" >
            <Condition>
              <IsVariableBool name="onGround">true</IsVariableBool>
            </Condition>
          </Transition>
          <Transition from="Fall|Grounded" to="Jump">
            <Condition type="and">
              <IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
              <IsVariableBool name="onGround">false</IsVariableBool>
            </Condition>
          </Transition>
          <Transition from="Jump|Grounded" to="Fall">
            <Condition type="and">
              <IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
              <IsVariableBool name="onGround">false</IsVariableBool>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="HoodState">
        <States start="On">
          <State name="On" />
          <State name="Off" />
        </States>
        <Transitions>
          <Transition to="Off" from="On">
            <Condition>
              <CompareCustomVariable VariableNameToCompare="showHood">false</CompareCustomVariable>
            </Condition>
          </Transition>
          <Transition to="On" from="Off">
            <Condition>
              <CompareCustomVariable VariableNameToCompare="showHood">true</CompareCustomVariable>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="StardustState">
        <States start="On">
          <State name="On" />
          <State name="Off" />
        </States>
        <Transitions>
          <Transition to="Off" from="On">
            <Condition>
              <CompareCustomVariable VariableNameToCompare="showStardust">false</CompareCustomVariable>
            </Condition>
          </Transition>
          <Transition to="On" from="Off">
            <Condition>
              <CompareCustomVariable VariableNameToCompare="showStardust">true</CompareCustomVariable>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="AngelicState">
        <States start="On">
          <State name="On" />
          <State name="Off" />
        </States>
        <Transitions>
          <Transition to="Off" from="On">
            <Condition>
              <CompareCustomVariable VariableNameToCompare="showAngelic">false</CompareCustomVariable>
            </Condition>
          </Transition>
          <Transition to="On" from="Off">
            <Condition>
              <CompareCustomVariable VariableNameToCompare="showAngelic">true</CompareCustomVariable>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="Zombie">
        <States start="Off">
          <State name="On" />
          <State name="Off" />
        </States>
        <Transitions>
          <Transition to="Off" from="On">
            <Condition>
              <IsZombified>false</IsZombified>
            </Condition>
          </Transition>
          <Transition to="On" from="Off">
            <Condition>
              <IsZombified>true</IsZombified>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>
    
    <Animations>
      <SpriteAnimation name="a_Sparks" sprite="s_Sparks">
        <Frame>10,21</Frame>
        <Frame>11,21</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_CapeBackIdle" sprite="s_CapeBack" animTime="800" isLoop="true" playOnState="PlayerState.Grounded">
        <Frame>0,14</Frame>
        <Frame>1,14</Frame>
        <Frame>2,14</Frame>
        <Frame>3,14</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_CapeFrontIdle" sprite="s_CapeFront" animTime="800" isLoop="true" playOnState="PlayerState.Grounded">
        <Frame>0,13</Frame>
        <Frame>1,13</Frame>
        <Frame>2,13</Frame>
        <Frame>3,13</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_CapeBackJump" sprite="s_CapeBack" animTime="800" isLoop="true" playOnState="PlayerState.Jump">
        <Frame>4,14</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_CapeFrontJump" sprite="s_CapeFront" animTime="800" isLoop="true" playOnState="PlayerState.Jump">
        <Frame>4,13</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_CapeBackFall" sprite="s_CapeBack" animTime="400" isLoop="true" playOnState="PlayerState.Fall">
        <Frame>5,14</Frame>
        <Frame>6,14</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_CapeFrontFall" sprite="s_CapeFront" animTime="800" isLoop="true" playOnState="PlayerState.Fall">
        <Frame>5,13</Frame>
      </SpriteAnimation>
      <SpriteSinPulseAnimation name="a_Angelic_float" sprite="s_Angelic" autoPlay="true">
        <Parameter name="pos.y">
          <Set name="period">1500</Set>
          <Set name="scale">2</Set>
        </Parameter>
      </SpriteSinPulseAnimation>
      <SpriteSinPulseAnimation name="a_Angelic_opacity" sprite="s_Angelic" autoPlay="true" isLoop="true">
        <Parameter name="alpha">
          <Set name="period">1000</Set>
          <Set name="scale">0.25</Set>
          <Set name="offset">0.75</Set>
        </Parameter>
      </SpriteSinPulseAnimation>
    </Animations>
    
    <ParticleSystems>
      <ParticleSystem name="ps_sparks_left" updateStage="AddClothingParticles" updateState="StardustState.On">
        <Emitter>
          <Set name="lifeTime">0.4</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">4</Set>
          <Set name="emissionInterval">0.3</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="offset">0,-10</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_Sparks</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="lifeTime">1</Set>
          <RandomRadial name="initialVelocity" angleRange="225,270" radiusRange="25,25" />
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.75, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Random name="offset" min="-25, 0" max="0, 0" />
          <Set name="relativeToEmitter">true</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_sparks_right" updateStage="AddClothingParticles" updateState="StardustState.On">
        <Emitter>
          <Set name="lifeTime">0.4</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">4</Set>
          <Set name="emissionInterval">0.3</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="offset">0,-10</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_Sparks</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="lifeTime">1</Set>
          <RandomRadial name="initialVelocity" angleRange="270,315" radiusRange="25,25" />
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.75, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Random name="offset" min="0, 0" max="25, 0" />
          <Set name="relativeToEmitter">true</Set>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
    
    <VariableMap>
      <Set name="showHood" UIOrder="1" RadioGroup="-1" UIName="Show Hood">true</Set>
      <Set name="showStardust" UIOrder="2" RadioGroup="-1" UIName="Show Stardust Aura">true</Set>
      <Set name="showAngelic" UIOrder="3" RadioGroup="-1" UIName="Show Angelic Aura">true</Set>
    </VariableMap>
    
  </Data>
  <RenderRules>
    <RenderBackpack>
      <ParticleSystemRender name="ps_sparks_left"/>
      <ParticleSystemRender name="ps_sparks_right"/>
      <SpriteRender name="s_Angelic" offset="0,-30" blend="PREMULTIPLIED_ALPHA" onState="AngelicState.On" drawShadow="false"/>
      <SpriteRender name="s_CapeBack" offset="0,-31" blend="PREMULTIPLIED_ALPHA"/>
      <SpriteRender name="s_HoodBack" offset="0,-30" blend="PREMULTIPLIED_ALPHA" onState="HoodState.On"/>
    </RenderBackpack>
    <RenderInFront>
      <StopIf>
        <IsTrnsformed>true</IsTrnsformed>
        <IsSleepingOnaBed>true</IsSleepingOnaBed>
        <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
        <IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_REBEL_RAIDER</IsWearing>
        <IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_IMPERIAL_ENFORCER</IsWearing>
      </StopIf>

      <ContextUpdate type="SetTint" onState="Zombie.On">
        <Set name="tint">111,217,45</Set>
        <Set name="forceTint">true</Set>
      </ContextUpdate>
      
      <SpriteRender name="s_Hood" offset="0,-30" blend="PREMULTIPLIED_ALPHA" drawShadow="false" onState="HoodState.On"/>
      <SpriteRender name="s_CapeFront" offset="0,-31" blend="PREMULTIPLIED_ALPHA" drawShadow="false"/>
      
    </RenderInFront>
  </RenderRules>
</ItemRenderer>
