<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer item="ITEM_ID_IMMORTAL_SONIC_BUSTER_KATANA">
	<Data>
		<Sprite name="Strap" fileName="game/particles12.rttex" textureSize="32" frame="11,25"/>
		
		<Sprite name="sword_Sprite" fileName="game/player_longhanditem4.rttex" textureSize="64,32" frame="7,12"/>
		<Sprite name="sword_back_Sprite" fileName="game/particles_large18.rttex" textureSize="64,64" frame="15,10"/>
		
		<Sprite name="sword_back_glowing_Sprite" fileName="game/particles_large18.rttex" textureSize="64,64" frame="13,10"/>
		<Sprite name="sword_back_glowing_front_Sprite" fileName="game/particles_large18.rttex" textureSize="64,64" frame="14,10"/>
		
		<Sprite name="sword_slash_sparkle" fileName="game/particles12.rttex" textureSize="32" frame="4,25"/>
		<Sprite name="sword_slash_Sprite" fileName="game/particles12.rttex" textureSize="32" frame="8,25"/>
		
		<Sprite name="hit_Sprite" fileName="game/particles12.rttex" textureSize="32" frame="0,25"/>
		<Sprite name="hit_slash_Sprite" fileName="game/particles12.rttex" textureSize="32" frame="10,25"/>
		<Sprite name="breakStamp" fileName="game/particles12.rttex" textureSize="32" frame="3,25"/>
		<StateMachines>
			<StateMachine name="Action">
				<States>
					<State name="None"/>
					<State name="Punch"/>
				</States>
				<Transitions>
					<Transition from="None" to="Punch">
						<Condition type="and">
							<IsAction>PUNCH</IsAction>
							<IsZombified>false</IsZombified>
						</Condition>
					</Transition>
					<Transition from="Punch" to="None">
						<Condition type="or">
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
							<IsZombified>true</IsZombified>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<Animations>
			<SpriteCurveAnimation name="sword_glowing_Sprite_idle" isLoop="true" playOnState="Action.None" sprite="sword_back_glowing_front_Sprite" animTime="5000">
				<Curve name="alpha">
					<KeyFrame>0.f, 0.f</KeyFrame>
					<KeyFrame>0.2f, 0.f </KeyFrame>
					<KeyFrame>0.4f, 1.f</KeyFrame>
					<KeyFrame>0.8f, 1.f</KeyFrame>
					<KeyFrame>1.f, 0.f</KeyFrame>
				</Curve>
			</SpriteCurveAnimation>
			<SpriteCurveAnimation name="sword_glowing_Sprite_punch" isLoop="true" sprite="sword_back_Sprite" animTime="100" playOnState="Action.Punch">
				<Frame>15,10</Frame>
			</SpriteCurveAnimation>
			<SpriteAnimation name="sword_slash_frames" autoPlay="false" sprite="sword_slash_Sprite">
				<Frame>8,25</Frame>
				<Frame>9,25</Frame>
			</SpriteAnimation>			
			<SpriteAnimation name="sword_sparkle_frames" autoPlay="false" sprite="sword_slash_sparkle">
				<Frame>4,25</Frame>
				<Frame>5,25</Frame>
				<Frame>6,25</Frame>
				<Frame>7,25</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="hit_Sprites" autoPlay="false" sprite="hit_Sprite">
				<Frame>0,25</Frame>
				<Frame>1,25</Frame>
				<Frame>2,25</Frame>
			</SpriteAnimation>
		</Animations>
		<ParticleSystems>
			<ParticleSystem name="trail_particle">
				<Emitter>
					<Set name="lifeTime">0.5</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">16</Set>
					<Set name="emissionInterval">0.035</Set>
					<Set name="checkParticleNumToEmit">true</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Random name="offset" min="-6, -8" max="6, 8" />
					<Set name="sprite">sword_slash_sparkle</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Random name="initialScale" min="0.5" max="1" />
					<Set name="lifeTime">0.3</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="slash_particle" secondary="trail_particle">
				<Emitter>
					<Set name="offset">0,-22</Set>
					<Set name="emissionInterval">0.25</Set>
					<Set name="lifeTime">0.25</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle alternateSpriteFrameWithPunch="true">
					<Random name="offset" min="0, -12" max="0, 12" />
					<Set name="sprite">sword_slash_Sprite</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.4</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="interpolateAlpha">false</Set>
					<Set name="initialAlpha">1</Set>
					<Set name="finalAlpha">1</Set>
					<Set name="interpolateVelocity">true</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
					<VectorTo name="finalVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="hit_particle">
				<Emitter>
					<Set name="offset">0,0</Set>
					<Set name="lifeTime">2</Set>
					<Set name="particlesPerEmission">8</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">hit_Sprite</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="isBackgroundParticle">false</Set>
					<Set name="useGravity">true</Set>
					<Set name="lifeTime">1</Set>
					<Set name="gravityVector">0, 100</Set>
					<Set name="initalRGB">1,1,1</Set>
					<Set name="initialRotationRate">15</Set>
					<Set name="finalRotationRate">5</Set>
					<Set name="initialAlpha">1</Set>
					<Set name="finalAlpha">0</Set>
					<Set name="interpolateAlpha">true</Set>
					<Set name="interpolateScale">true</Set>
					<Set name="initialScale">1,1</Set>
					<Random name="finalScale" min="0.2" max="0.5"/>
					<Set name="interpolateAngle">true</Set>
					<Random name="initialAngle" min="-360" max="360"/>
					<Random name="finalAngle" min="-360" max="360"/>
					<RandomRadial name="initialVelocity" angleRange="30,330" radiusRange="13.5,150"/>
					<Random name="posOffset" min="0, 0" max="16,16"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="p_hit_slash" updateStage="OnDamagedTile">
				<Emitter>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Random name="particlesToEmit" min="1" max="4" />
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="emissionInterval">0.05</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">hit_slash_Sprite</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.5, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.75</Set>
					<Random name="initialAngle" min="0" max="360" />
					<Random name="offset" min="-10, -10" max="10,10"/>
					<Random name="initialScale" min="0.7" max="1.0"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="break_particle_stamp">
				<Emitter>
					<Set name="particlesToEmit">1</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Random name="initialAngle" min="-360" max="360"/>
					<Set name="sprite">breakStamp</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.5</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 1,1</KeyFrame>
						<KeyFrame>1, 1.3,1.3</KeyFrame>
					</Curve>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		
		<RenderOptions>
			<Default>
				<Set name="DefaultRenderMannequinHandItem">false</Set>
				<Set name="HideParticlesOnTransform">false</Set>
				<Set name="IgnoreDefaultDestroyedTileEffect">true</Set>
				<Set name="PunchSoundOverride">HAND</Set>
				<Set name="RenderFrontArmInfected">true</Set>
				<Set name="RenderBackArmInfected">true</Set>
			</Default>
		</RenderOptions>
		
	</Data>

	<RenderRules>
		<RenderHandItem value="1.23,7.3" >
			<StopIf type="or">
				<IsAction operatorType="NotEqual">PUNCH</IsAction>
				<IsZombified>true</IsZombified>
			</StopIf>
			<SpriteRender name="sword_Sprite"/>
		</RenderHandItem>
		<RenderInFront>
			<ParticleSystemRender name="hit_particle"/>
		</RenderInFront>
		<RenderFrontArm>
			<SpriteRender name="Strap" alignment="DOWN_CENTER" useFixedRotation="true" fixedRotation="0"/>
		</RenderFrontArm>
		<RenderBackArm value="playerCenter">
			<StopIf type="or">
				<IsSleepingOnaBed>true</IsSleepingOnaBed>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
				<IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_REBEL_RAIDER</IsWearing>
				<IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_IMPERIAL_ENFORCER</IsWearing>
			</StopIf>
			<SpriteRender name="sword_back_Sprite" offset="-0.2, -32" useFixedRotation="true" fixedRotation="0"/>
			<StopIf type="and">
				<IsAction>PUNCH</IsAction>
				<IsZombified>false</IsZombified>
			</StopIf>
			<SpriteRender name="sword_back_glowing_Sprite" offset="-0.2, -32" blend="PREMULTIPLIED_ALPHA" drawShadow="false" useFixedRotation="true" fixedRotation="0"/>
			<SpriteRender name="sword_back_glowing_front_Sprite" offset="-0.2, -32" blend="PREMULTIPLIED_ALPHA" drawShadow="false" useFixedRotation="true" fixedRotation="0"/>
		</RenderBackArm>
		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">1200</Set>
				<Set name="isAdditive">true</Set>
				<Set name="pointTowardsPunchTarget">false</Set>
			</AvatarTransform>
		</OnPunchUpdate>
		<OnPunchStart>
			<ParticleSystemUpdate name="slash_particle"/>
		</OnPunchStart>
		<OnDamagedTile>
			<ParticleSystemUpdate name="hit_particle"/>
		</OnDamagedTile>
		<OnDestroyedTile>
			<ParticleSystemUpdate name="hit_particle"/>
			<ParticleSystemUpdate name="break_particle_stamp"/>
		</OnDestroyedTile>
	</RenderRules>
</ItemRenderer>