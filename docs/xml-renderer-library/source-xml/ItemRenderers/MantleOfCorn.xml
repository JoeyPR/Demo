<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_back" fileName="game/particles_large18.rttex" textureSize="64" frame="7,13" />
    <Sprite name="s_front" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="30,10" />
    <Sprite name="s_popcorn" fileName="game/particles12.rttex" textureSize="32" frame="10,22" />
    <Sprite name="s_flash" fileName="game/particles12.rttex" textureSize="32" frame="12,22" />
    
    <Animations>
      <SpriteAnimation name="a_back" sprite="s_back" animTime="800" autoPlay="true" isLoop="true">
        <Frame>7,13</Frame>
        <Frame>8,13</Frame>
        <Frame>9,13</Frame>
        <Frame>10,13</Frame>
        <Frame>11,13</Frame>
        <Frame>12,13</Frame>
        <Frame>13,13</Frame>
        <Frame>14,13</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_popcorn" sprite="s_popcorn" animTime="200">
        <Frame>10,22</Frame>
        <Frame>11,22</Frame>
      </SpriteAnimation>
    </Animations>

    <StateMachines>
      <StateMachine name="Action">
        <States>
          <State name="None" />
          <State name="Punch" />
        </States>
        <Transitions>
          <Transition to="None" from="Punch">
            <Condition>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="Punch" from="None">
            <Condition>
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>
    
    <ParticleSystems>
      <ParticleSystem name="ps_flash" updateStage="AddClothingParticles" renderStage="RenderChestBackItem" updateState="Action.Punch">
        <Emitter>
          <Set name="offset">0, -32</Set>
          <Set name="enable">true</Set>
          <Set name="offsetFacing">false</Set>
          <Set name="emissionInterval">0.4</Set>
          <Set name="useCharacterPos">false</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_flash</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="isBackgroundParticle">false</Set>
          <Set name="lifeTime">0.1</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.75, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Random name="offset" min="-16,-8" max="16,0"/>
          <OnFinish>
            <ParticleSystemName>ps_popcorn</ParticleSystemName>
          </OnFinish>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_popcorn">
        <Emitter>
          <Set name="lifeTime">1</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="offset">0,0</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="checkParticleNumToEmit">true</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_popcorn</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="useGravity">true</Set>
          <Set name="lifeTime">1</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.75, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Random name="initialRotationRate" min="-180" max="180"/>
          <Random name="initialScale" min="0.5" max="1"/>
          <RandomRadial name="initialVelocity" angleRange="225,315" radiusRange="60,100"/>
          <Set name="gravityVector">0, 90</Set>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
    <RenderOptions>
      <Default>
        <Set name="IgnorePunchTypeCheck">true</Set>
        <Set name="UserNameOffset">8</Set>
      </Default>
    </RenderOptions>
  </Data>
  <RenderRules>
    <RenderChestBackItem>
      <SpriteRender name="s_back" drawShadow="false" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_CENTER" />
    </RenderChestBackItem>
    <RenderChestItem>
      <SpriteRender name="s_front" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_CENTER" />
    </RenderChestItem>
  </RenderRules>
</ItemRenderer>
