<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_back" fileName="game/particles_large18.rttex" textureSize="64" frame="11,6" />
    <Sprite name="s_godRays" fileName="game/particles_large18.rttex" textureSize="64" frame="12,6" />
    <Sprite name="s_leaves" fileName="game/particles.rttex" textureSize="32" frame="1,5" />

    <Animations>
      <SpriteCurveAnimation name="a_back" autoPlay="true" isLoop="true" sprite="s_back" animTime="2000">
        <Curve name="pos.y">
          <KeyFrame>0.f, -2</KeyFrame>
          <KeyFrame>0.5f, 2</KeyFrame>
          <KeyFrame>1.f, -2</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>
      <SpriteAnimation name="a_godRays" sprite="s_godRays">
        <Frame>12,6</Frame>
        <Frame>13,6</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_leaves" sprite="s_leaves">
        <Frame>1,5</Frame>
        <Frame>2,5</Frame>
        <Frame>3,5</Frame>
        <Frame>4,5</Frame>
      </SpriteAnimation>
    </Animations>

    <ParticleSystems>
      <ParticleSystem name="ps_godrays" updateStage="AddClothingParticles" renderStage="RenderBackpack">
        <Emitter>
          <Set name="offset">0, -28</Set>
          <Set name="enable">true</Set>
          <Set name="offsetFacing">false</Set>
          <Set name="emissionInterval">1.5</Set>
          <Set name="useCharacterPos">false</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle particleIndexSpriteFrame="true">
          <Set name="sprite">s_godRays</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="inSpecificOrder">true</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="isBackgroundParticle">false</Set>
          <Set name="lifeTime">2</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_leaves_right" updateStage="AddClothingParticles" renderStage="RenderBackpack">
        <Emitter>
          <Set name="offset">20,-32</Set>
          <Random name="emissionInterval" min="0.75" max="1" />
          <Set name="infParticles">true</Set>
          <Set name="lifeTime">0.75</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle randomSpriteFrame="true"  usePlayerFacing="true">
          <Set name="sprite">s_leaves</Set>
          <Random name="offset" min="0, -16" max="0, 16" />
          <Set name="inSpecificOrder">true</Set>
          <Set name="lifeTime">1</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0.5</KeyFrame>
            <KeyFrame>0.3, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Random name="initialScale" min="0.3" max="0.4" />
          <Set name="useGravity">true</Set>
          <Set name="initialVelocity">5, 10</Set>
          <Random name="gravityVector" min="0,5" max="0,10" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_leaves_left" updateStage="AddClothingParticles" renderStage="RenderBackpack">
        <Emitter>
          <Set name="offset">-20,-32</Set>
          <Random name="emissionInterval" min="0.75" max="1" />
          <Set name="infParticles">true</Set>
          <Set name="lifeTime">0.7</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle randomSpriteFrame="true" usePlayerFacing="true">
          <Set name="sprite">s_leaves</Set>
          <Random name="offset" min="0, 16" max="0, -16" />
          <Set name="inSpecificOrder">true</Set>
          <Set name="flipX">true</Set>
          <Set name="lifeTime">1</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0.5</KeyFrame>
            <KeyFrame>0.3, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Random name="initialScale" min="0.3" max="0.4" />
          <Set name="useGravity">true</Set>
          <Set name="initialVelocity">5, 10</Set>
          <Random name="gravityVector" min="0,5" max="0,10" />
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
    <RenderOptions>
      <Default>
        <Set name="IgnorePunchTypeCheck">true</Set>
        <Set name="UserNameOffset">8</Set>
      </Default>
    </RenderOptions>
  </Data>
  <RenderRules>
    <RenderBackpack>
      <SpriteRender name="s_back" drawShadow="false" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_CENTER" />
      <StopIf>
        <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
      </StopIf>
    </RenderBackpack>
  </RenderRules>
</ItemRenderer>
