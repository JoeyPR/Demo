<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_golem" fileName="game/particles_large18.rttex" textureSize="64" frame="0, 12"/>
		<Sprite name="s_trail_sprite" fileName="game/particles12.rttex" textureSize="32" frame="0, 12"/>
		<Sprite name="s_rocks" fileName="game/particles12.rttex" textureSize="32" frame="19,17"/>
		<Sprite name="s_rocksTrail" fileName="game/particles12.rttex" textureSize="32" frame="19,17"/>
		<Sprite name="s_flash" fileName="game/particles12.rttex" textureSize="32" frame="6,10" />
		<Sprite name="s_legs" fileName="game/player_sit.rttex" textureSize="32" frame="1,0" />
		<Animations>
			<SpriteAnimation name="a_golem_idle" sprite="s_golem" animTime="200" isLoop="true" playOnState="State.Idle">
				<Frame>0, 12</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_golem_jump" sprite="s_golem" animTime="200" isLoop="true" playOnState="State.Jump">
				<Frame>8, 12</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_golem_fall" sprite="s_golem" animTime="200" isLoop="true" playOnState="State.Fall">
				<Frame>9, 12</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_golem_move" sprite="s_golem" animTime="700" isLoop="true" playOnState="State.Move">
				<Frame>1, 12</Frame>
				<Frame>2, 12</Frame>
				<Frame>3, 12</Frame>
				<Frame>4, 12</Frame>
				<Frame>5, 12</Frame>
				<Frame>6, 12</Frame>
				<Frame>7, 12</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_golem_punch" sprite="s_golem" animTime="200" isLoop="true" playOnState="State.Punch">
				<Frame>10, 12</Frame>
				<Frame>11, 12</Frame>
				<Frame>12, 12</Frame>
				<Frame>13, 12</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_rocks" sprite="s_rocks" autoPlay="false" animTime="400">
				<Frame>19,21</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_rocksTrail" sprite="s_rocksTrail" autoPlay="false" animTime="500">
				<Frame>19,21</Frame>
				<Frame>15,21</Frame>
				<Frame>15,21</Frame>
				<Frame>15,21</Frame>
				<Frame>16,21</Frame>
				<Frame>17,21</Frame>
				<Frame>18,21</Frame>
			</SpriteAnimation>
		</Animations>
		<StateMachines>
			<StateMachine name="State">
				<States>
					<State name="Idle" />
					<State name="Punch"/>
					<State name="Move" />
					<State name="Jump" />
					<State name="Fall" />
				</States>
				<Transitions>
					<Transition to="Idle" from="Fall|Move|Punch">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="Idle|Move|Jump|Fall" >
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Move" from="Jump|Fall|Idle|Punch">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Jump" from="Idle|Move|Fall|Punch">
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Fall" from="Jump|Idle|Move|Punch">
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<ParticleSystems>
			<ParticleSystem name="ps_Punch" secondary="ps_Trail">
				<Emitter>
					<Set name="offset">18, -10</Set>
					<Set name="lifeTime">0.4</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle autoLifeTimeToTarget="true">
					<Set name="sprite">s_rocks</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.4</Set>
					<VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="1"/>
					<Set name="initialAlpha">0</Set>
					<OnFinish>
						<ParticleSystemName>ps_Flash</ParticleSystemName>
					</OnFinish>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_Trail">
				<Emitter>
					<Set name="lifeTime">0.4</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">16</Set>
					<Set name="emissionInterval" source="Interval"/>
				</Emitter>
				<Particle>
					<Set name="sprite">s_rocksTrail</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.5</Set>
					<Set name="useGravity">true</Set>
					<Set name="initialScale">0.8,0.8</Set>
					<Set name="gravityVector">0, 200</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.8, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="inSpecificOrder">true</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_Flash">
				<Emitter attachment="targetPos">
					<Set name="lifeTime">0.4</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_flash</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.8, 0.8</KeyFrame>
						<KeyFrame>1, 1.8, 1.8</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.2</Set>
					<Random name="initialAngle" min="0" max="360"/>
					<Set name="inSpecificOrder">true</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<VariableMap>
			<Set name="LifeTime">0.4</Set>
			<Set name="Interval">0.07</Set>
			<Set name="NumTiles">0</Set>
			<Set name="TileWidth">32</Set>
			<Set name="Punch.GetDistance">0</Set>
		</VariableMap>
		<RenderOptions>
			<Default>
				<Set name="ShoesShouldIgnoreRaptorLegsOffset">true</Set>
				<Set name="UserNameOffset">8</Set>
				<Set name="IncludeAllActions">true</Set>
				<Set name="ShoesHidesBodyLegs">true</Set>
				<Set name="ShoesShouldIgnoreRaptorLegsOffset">true</Set>
				<Set name="IsToRenderPants">false</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
		<Update>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">0</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">0</Set>
			</AvatarTransform>
		</Update>
		<AddClothingParticles>
			<StopIf>
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
			</StopIf>
			<ArithmethicOperation LeftHandVariableName="NumTiles" RightHandVariableName="Punch.GetDistance" OperationType="Set"/>
			<ArithmethicOperation LeftHandVariableName="NumTiles" RightHandVariableName="TileWidth" OperationType="Divide"/>
			<ArithmethicOperation LeftHandVariableName="Interval" RightHandVariableName="LifeTime" OperationType="Set"/>
			<ArithmethicOperation LeftHandVariableName="Interval" RightHandVariableName="NumTiles" OperationType="Divide"/>
			<ArithmethicOperation LeftHandVariableName="Interval" RightHandVariableName="0.7" OperationType="Multiply"/>
			<ParticleSystemUpdate name="ps_Punch" onState="State.Punch"/>
		</AddClothingParticles>
		<RenderShoes>
			<SpriteRender name="s_legs" offset="1,-7" tintOverride="SKINORPANTS" />
		</RenderShoes>
		<RenderInFront>
			<ParticleSystemRender name="ps_Trail"/>
			<ParticleSystemRender name="ps_Flash"/>
		</RenderInFront>
		<RenderBehind>
			<StopIf>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
				<IsSitting ItemID="ITEM_ID_THEATER_SEAT">true</IsSitting>
				<IsSleepingOnaBed>true</IsSleepingOnaBed>
				<IsZombified>true</IsZombified>
				<IsSitting>true</IsSitting>
				<IsTrnsformed>true</IsTrnsformed>
			</StopIf>
			<Translate>6,-8,0</Translate>
			<SpriteRender name="s_golem"/>
		</RenderBehind>
		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
		</OnPunchUpdate>
	</RenderRules>
</ItemRenderer>