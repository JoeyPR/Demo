<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_front_hair" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="0,12"/>
    <Sprite name="s_back_hair" fileName="game/particles_large19.rttex" textureSize="64" frame="0,0"/>
    
    <Animations>
      <SpriteAnimation name="a_front_hair" sprite="s_front_hair" isLoop="true" animTime="1400" playOnState="Action.Equip">
        <Frame>0,12</Frame>
        <Frame>1,12</Frame>
        <Frame>2,12</Frame>
        <Frame>3,12</Frame>
        <Frame>4,12</Frame>
        <Frame>5,12</Frame>
        <Frame>6,12</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_back_hair" sprite="s_back_hair" isLoop="true" animTime="1400" playOnState="Action.Equip">
        <Frame>0,0</Frame>
        <Frame>1,0</Frame>
        <Frame>2,0</Frame>
        <Frame>3,0</Frame>
        <Frame>4,0</Frame>
        <Frame>5,0</Frame>
        <Frame>6,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_front_hair_jump" sprite="s_front_hair" isLoop="true" animTime="800" playOnState="Action.Jump">
        <Frame>0,13</Frame>
        <Frame>1,13</Frame>
        <Frame>2,13</Frame>
        <Frame>3,13</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_back_hair_jump" sprite="s_back_hair" isLoop="true" animTime="800" playOnState="Action.Jump">
        <Frame>7,0</Frame>
        <Frame>8,0</Frame>
        <Frame>9,0</Frame>
        <Frame>10,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_front_hair_fall" sprite="s_front_hair" isLoop="true" animTime="400" playOnState="Action.Fall">
        <Frame>4,13</Frame>
        <Frame>5,13</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_back_hair_fall" sprite="s_back_hair" isLoop="true" animTime="400" playOnState="Action.Fall">
        <Frame>11,0</Frame>
        <Frame>12,0</Frame>
      </SpriteAnimation>
    </Animations>

    <StateMachines>
      <StateMachine name="Action">
        <States>
          <State name="Equip" />
          <State name="Jump" />
          <State name="Fall" />
        </States>
        <Transitions>
          <Transition to="Equip" from="Fall|Jump">
            <Condition>
              <IsVariableBool name="onGround">true</IsVariableBool>
            </Condition>
          </Transition>
          <Transition to="Jump" from="Equip|Fall">
            <Condition type="and">
              <IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
              <IsVariableBool name="onGround">false</IsVariableBool>
            </Condition>
          </Transition>
          <Transition to="Fall" from="Equip|Jump">
            <Condition type="and">
              <IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
              <IsVariableBool name="onGround">false</IsVariableBool>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>

  </Data>

  <RenderRules>
    <RenderBackHair>
      <StopIf>
        <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
      </StopIf>
      <SpriteRender name="s_back_hair" alignment="DOWN_CENTER" blend="PREMULTIPLIED_ALPHA"/>
    </RenderBackHair>
    <RenderHair>
      <SpriteRender name="s_front_hair" alignment="DOWN_CENTER" offset="0,-16" blend="PREMULTIPLIED_ALPHA"/>
    </RenderHair>
  </RenderRules>
</ItemRenderer>